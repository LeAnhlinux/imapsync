[Unit]
Description=imapsync Web UI
After=network.target

[Service]
Type=simple
User=imapsync
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__INSTALL_DIR__/imapsync-web
Restart=always
RestartSec=5

# The binary is static and only needs its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__INSTALL_DIR__/data

[Install]
WantedBy=multi-user.target
