# WebSocket upgrades need Connection: upgrade, ordinary requests need
# Connection: close. Sending "upgrade" unconditionally, as this did, is wrong
# per RFC 9110 on every non-upgrade request and prevents upstream keepalive.
# This map belongs at http{} scope; nginx accepts it here in a conf.d-style
# include on Debian, but if your layout differs, move it to nginx.conf.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Frontend static files
    root __INSTALL_DIR__/static;
    index index.html;

    server_tokens off;

    # Batch CSV upload — the one endpoint group that takes a large body. Keep
    # this in step with maxCSVUpload in the backend. The prefix covers both
    # /api/batch/upload (multipart) and /api/batch/upload-text (JSON).
    location /api/batch/upload {
        client_max_body_size 20M;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Everything else. The limit is enforced here rather than only in the
    # backend: when the backend rejects an oversized body it answers 413 and
    # closes, but nginx is still writing the body it buffered, so it sees a
    # broken pipe, discards the 413 and reports 502 instead. Refusing at the
    # proxy gives the caller the right status.
    location /api/ {
        client_max_body_size 1M;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # A WebSocket follows a sync for hours, and /api/folders/browse takes
        # four to five minutes on a large Gmail account.
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers. Certbot moves this block to :443 and creates a fresh
    # :80 redirect, so HSTS ends up where it belongs — a browser ignores it
    # over plain HTTP anyway.
    #
    # This site takes mailbox passwords, and without HSTS the first visit to
    # a bare hostname still travels over HTTP before the 301. "always" on all
    # of them so they are sent on error responses too, not just on 2xx.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # The frontend loads nothing from anywhere else: no CDN, no third-party
    # script, no external font. Saying so limits what an injected script could
    # do with a session token, which lives in localStorage.
    add_header Content-Security-Policy
        "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Static files and the SPA shell need nothing large.
    client_max_body_size 1M;
}
