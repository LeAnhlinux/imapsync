server {
    listen 80;
    server_name __DOMAIN__;

    # Frontend static files
    root __INSTALL_DIR__/static;
    index index.html;

    # API + WebSocket proxy
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers. Certbot moves this block to :443 and creates a fresh
    # :80 redirect, so HSTS ends up where it belongs — a browser ignores it
    # over plain HTTP anyway.
    #
    # This site takes mailbox passwords, and without HSTS the first visit to
    # a bare hostname still travels over HTTP before the 301. "always" so it
    # is sent on error responses too.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    # Upload limit for batch CSV
    client_max_body_size 50M;
}
