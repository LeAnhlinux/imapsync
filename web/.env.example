SECRET_KEY=change-me-use-openssl-rand-hex-32
IMAPSYNC_FERNET_KEY=change-me-use-python-fernet-generate-key
DATABASE_URL=sqlite:///./data/imapsync.db
IMAPSYNC_PATH=/usr/local/bin/imapsync
DOMAIN=localhost

# --- Telegram bot (optional; all three required to enable) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to command the bot. Get yours by messaging
# the bot and reading the log, or via @userinfobot. This is the only access
# control: anyone in this list can start syncs and read job summaries.
TELEGRAM_ALLOWED_CHAT_IDS=
# Username of the app account the bot acts as (its profiles and jobs)
TELEGRAM_USERNAME=admin
