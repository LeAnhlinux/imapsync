SECRET_KEY=change-me-use-openssl-rand-hex-32
IMAPSYNC_FERNET_KEY=change-me-use-python-fernet-generate-key
DATABASE_URL=sqlite:///./data/imapsync.db
IMAPSYNC_PATH=/usr/local/bin/imapsync
DOMAIN=localhost

# --- Telegram bot ---
# Configured from the Settings page in the web UI, not here. These variables
# are read once, only to seed the database on first start if you set them
# before the settings page existed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_USERNAME=
